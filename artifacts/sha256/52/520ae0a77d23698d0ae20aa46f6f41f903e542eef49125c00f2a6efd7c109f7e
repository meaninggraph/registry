      "bindings": [
        {
          "model": "modelspec:///northwind.OrderDetails",
          "role": "entity"
        }
      ]
    },
    {
      "id": "shipping-country",
      "kind": "attribute",
      "description": "The country to which the order is shipped.",
      "labels": {
        "en": "shipping country"
      },
      "values-of": "meaning://github.com/meaninggraph/core/country?ref=982916d73f0a35ff2558b0062f58aa3ac4f24d97",
      "bindings": [
        {
          "model": "modelspec:///northwind.Orders",
          "property": "ShipCountry",
          "role": "value"
        }
      ]
    }
  ]
